TELEGRAM_BOT_TOKEN=123456:ABC...   # from @BotFather

# "claude" (best quality) or "google". Default: claude if ANTHROPIC_API_KEY is set, else google.
TRANSLATOR=claude

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Cloud Translation API (v2) key
GOOGLE_API_KEY=

# Comma-separated Telegram user IDs allowed to use the bot (send /id to the bot to see yours).
ALLOWED_USERS=

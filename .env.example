TELEGRAM_BOT_TOKEN=123456:ABC...   # from @BotFather

# "claude" (best), "gemini" (free tier), or "google". Default: first key found in that order.
TRANSLATOR=claude

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Free key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Translation API (v2) key
GOOGLE_API_KEY=

# Comma-separated Telegram user IDs allowed to use the bot (send /id to the bot to see yours).
ALLOWED_USERS=

# Webhook mode (set automatically on Render via RENDER_EXTERNAL_URL); empty = long polling.
WEBHOOK_URL=
